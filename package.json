{
    "name": "learning-curve",
    "version": "1.0.0",
    "description": "An Angular 19 platform",
    "scripts": {
        "ng": "ng",
        "start": "npm run generate:nav && ng serve",
        "build": "npm run generate:nav && ng build",
        "build:prod": "npm run generate:nav && ng build --configuration production",
        "build:gitlab": "npm run generate:nav && ng build --configuration gitlab",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "lint": "ng lint",
        "generate:nav": "node scripts/generate-docs-nav.js",
        "deploy:github": "npm run build:prod && npx angular-cli-ghpages --dir=dist/learning-curve/browser",
        "predeploy": "npm run generate:nav"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^19.0.0",
        "@angular/common": "^19.0.0",
        "@angular/compiler": "^19.0.0",
        "@angular/core": "^19.0.0",
        "@angular/forms": "^19.0.0",
        "@angular/platform-browser": "^19.0.0",
        "@angular/platform-browser-dynamic": "^19.0.0",
        "@angular/router": "^19.0.0",
        "marked": "^12.0.0",
        "marked-highlight": "^2.1.1",
        "prismjs": "^1.29.0",
        "rxjs": "^7.8.1",
        "tslib": "^2.6.2",
        "zone.js": "^0.15.0"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^19.0.0",
        "@angular/cli": "^19.0.0",
        "@angular/compiler-cli": "^19.0.0",
        "@types/prismjs": "^1.26.3",
        "typescript": "~5.6.0"
    },
    "engines": {
        "node": ">=18.19.0",
        "npm": ">=10.0.0"
    }
}